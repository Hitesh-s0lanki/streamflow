# Copy to .env and fill in values. Do not commit .env.
# For CI/CD: add these as GitHub Secrets and set the same vars in Render (or your host) environment.

# ---------- Database (required for deployment) ----------
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/streamflow
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=

# ---------- Docker deploy workflow (GitHub Secrets) ----------
# IMAGE_NAME          - Full image name, e.g. ghcr.io/owner/streamflow-be
# RENDER_DEPLOY_HOOK_URL - Render deploy hook URL (with ?key=...)

# ---------- AWS S3 (required if STREAMFLOW_AWS_S3_ENABLED=true) ----------
STREAMFLOW_AWS_S3_ENABLED=true
STREAMFLOW_AWS_S3_REGION=us-east-1
STREAMFLOW_AWS_S3_BUCKET=
STREAMFLOW_AWS_S3_ACCESS_KEY_ID=
STREAMFLOW_AWS_S3_SECRET_ACCESS_KEY=
# Optional: for MinIO or custom S3-compatible endpoint
# STREAMFLOW_AWS_S3_ENDPOINT_OVERRIDE=http://localhost:9000
# STREAMFLOW_AWS_S3_PATH_STYLE_ACCESS=true

# ---------- API (optional) ----------
# STREAMFLOW_API_BASE_URL=https://api.example.com
